rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'name', 'status'])
          && data.id == userId
          && data.name is string && data.name.size() <= 50
          && data.status in ['idle', 'matching', 'active'];
      }
      
      // Allow user to read other users to see their names and interests
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId 
                    && incoming().id == existing().id;
    }

    match /rooms/{roomId} {
      // both host and guest can read and write to the room to do signaling
      function isRoomMember(data) {
        return request.auth.uid == data.hostId || request.auth.uid == data.guestId;
      }
      
      allow read: if isSignedIn() && isRoomMember(existing());
      allow create: if isSignedIn() && (request.auth.uid == incoming().hostId || request.auth.uid == incoming().guestId);
      allow update: if isSignedIn() && isRoomMember(existing());
      allow delete: if isSignedIn() && isRoomMember(existing());

      match /messages/{messageId} {
        function getRoom() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }
        
        allow read: if isSignedIn() && isRoomMember(getRoom());
        allow create: if isSignedIn() 
                      && isRoomMember(getRoom())
                      && incoming().sender == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
    }
  }
}
