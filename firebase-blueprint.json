{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the JustChat app",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ageVerified": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "interests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "type": "string", "enum": ["idle", "matching", "active"] },
        "roomId": { "type": "string" },
        "lastSeen": { "type": "number" },
        "chatMode": { "type": "string", "enum": ["video", "text"] },
        "matchingStartedAt": { "type": "number" }
      },
      "required": ["id", "name", "status"]
    },
    "Room": {
      "title": "Room",
      "description": "An active chat room between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hostId": { "type": "string" },
        "guestId": { "type": "string" },
        "hostIce": { "type": "string" },
        "guestIce": { "type": "string" },
        "hostSdp": { "type": "string" },
        "guestSdp": { "type": "string" },
        "created": { "type": "number" },
        "lastActivity": { "type": "number" }
      },
      "required": ["id", "hostId", "guestId", "created"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "sender": { "type": "string" },
        "text": { "type": "string" },
        "time": { "type": "number" }
      },
      "required": ["sender", "text", "time"]
    },
    "Report": {
      "title": "Report",
      "description": "A user report",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "reportedId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["reporterId", "reportedId", "reason", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Active rooms"
    },
    "rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages in a room"
    },
    "reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "User reports"
    }
  }
}
